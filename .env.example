# Sao chép file này thành .env rồi điền giá trị thật
# Lấy Gemini API key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Tạo bot Telegram qua @BotFather để lấy token
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# (Nên đặt) Giới hạn user_id được dùng bot. Nhiều id cách nhau bằng dấu phẩy.
# VD: ALLOWED_USER_ID="12345678,98765432". Để trống = cho phép TẤT CẢ (không an toàn khi công khai).
ALLOWED_USER_ID=""

# (Tùy chọn) Deadline tổng cho bước cào dữ liệu, tính bằng giây. Mặc định 45.
FETCH_TOTAL_TIMEOUT="45"

# ===== TINH CHỈNH WEB UI (webapp.py) =====
# Số job phân tích chạy nền đồng thời. Mặc định 2.
WEB_JOB_WORKERS="2"
# Thời gian giữ kết quả job (giây) trước khi dọn. Mặc định 1800 (30 phút).
WEB_JOB_TTL="1800"
# Rate limit: tối đa bao nhiêu lần tạo job mỗi IP trong một cửa sổ. Mặc định 10.
WEB_RATE_MAX="10"
# Độ dài cửa sổ rate limit (giây). Mặc định 60.
WEB_RATE_WINDOW="60"

# ===== QUÉT ĐỊNH KỲ (scheduler.py) =====
# Danh sách chủ đề tự quét, cách nhau dấu phẩy.
SCHEDULED_TOPICS="iPhone 15, VinFast, Tesla"
# Chu kỳ quét (giờ). Mặc định 24.
SCAN_INTERVAL_HOURS="24"
# Lọc độ mới của dữ liệu khi quét: week / month / year (bỏ trống = không lọc).
SCAN_TIME_RANGE="week"
# (Tùy chọn) chat_id nhận tóm tắt qua Telegram sau mỗi lượt quét.
SCHEDULED_CHAT_ID=""

# ===== NGUỒN DỮ LIỆU TÙY CHỌN (để trống thì tự bỏ qua) =====

# YouTube Data API v3 - cào bình luận video.
# Lấy key tại: https://console.cloud.google.com/apis/credentials (bật "YouTube Data API v3")
YOUTUBE_API_KEY=""

# Reddit OAuth (app-only) - cào bài đăng.
# Tạo app dạng "script" tại: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="python:sentiment_bot:v1.0 (by /u/your_username)"
